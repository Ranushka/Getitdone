// GetItDone data model

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js (NextAuth) standard models — every User here is a manager ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Only set for managers who registered with email/password instead of
  // Google — null for Google-only accounts.
  password      String?
  accounts      Account[]
  sessions      Session[]
  jobs          Job[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum JobStatus {
  IN_PROGRESS
  TECH_SIGNED_OFF
  COMPLETED
}

model Job {
  id          String        @id @default(cuid())
  title       String
  notes       String?
  shareToken  String        @unique @default(cuid())
  status      JobStatus     @default(IN_PROGRESS)
  manager     User          @relation(fields: [managerId], references: [id])
  managerId   String
  items       ChecklistItem[]
  signOffs    SignOff[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum ItemStatus {
  PENDING
  DONE
}

model ChecklistItem {
  id          String       @id @default(cuid())
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId       String
  title       String
  comment     String?
  status      ItemStatus   @default(PENDING)
  order       Int          @default(0)
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  attachments Attachment[]
}

// A checklist item can carry multiple photos/videos — technician can keep
// tapping the camera button to add more before marking the item done.
model Attachment {
  id        String        @id @default(cuid())
  item      ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  url       String
  createdAt DateTime      @default(now())
}

enum SignOffRole {
  TECHNICIAN
  MANAGER
}

model SignOff {
  id        String      @id @default(cuid())
  job       Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     String
  role      SignOffRole
  name      String
  signedAt  DateTime    @default(now())

  @@unique([jobId, role])
}
