# Postgres (self-hosted on Mac Mini, or local for dev)
DATABASE_URL="postgresql://getitdone:getitdone@localhost:5433/getitdone"

# apps/api
JWT_SECRET="generate-with-openssl-rand-base64-32"
PORT=3659
WEB_ORIGIN="http://localhost:3658"
UPLOADS_DIR="./uploads"

# Google OAuth (console.cloud.google.com -> OAuth client -> Web application)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3659/api/auth/google/callback"

# OpenRouter (used for on-demand translation of user-typed job content)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-oss-20b"

# apps/web (only needed if the API isn't reachable via the dev proxy)
VITE_API_URL="/trpc"
